{
  "version": 2,
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
